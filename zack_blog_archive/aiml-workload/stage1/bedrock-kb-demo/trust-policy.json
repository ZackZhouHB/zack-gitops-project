{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Service": "bedrock.amazonaws.com"
            },
            "Action": "sts:AssumeRole",
            "Condition": {
                "StringEquals": {
                    "aws:SourceAccount": "381324498760"
                },
                "ArnLike": {
                    "aws:SourceArn": "arn:aws:bedrock:ap-southeast-2:381324498760:knowledge-base/*"
                }
            }
        }
    ]
}
