# ─────────────────────────────────────
# Project 125 — Environment Variables
# ─────────────────────────────────────
# Copy to .env and fill in real values
# ─────────────────────────────────────

# ── AWS Bedrock (reused from platform-health-agent) ──
AWS_PROFILE=sandboxtest
AWS_DEFAULT_REGION=ap-southeast-2
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIMENSIONS=1024

# ── Infrastructure (reused from platform-health-agent) ──
WEAVIATE_URL=http://vectordb:8080
POSTGRES_URL=postgresql://agent:agent@postgres:5432/agent_db

# ── Jira Cloud (NEW — Phase B) ──
JIRA_URL=https://your-site.atlassian.net
JIRA_EMAIL=your.email@example.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_PROJECT_KEY=PLAT

# ── Slack (NEW — Phase B) ──
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_DEFAULT_CHANNEL=#platform-alerts

# ── Slack Socket Mode (for Slack Bot entry point — M5.2) ──
SLACK_APP_TOKEN=xapp-your-slack-app-level-token-here

# ── Confluence (reused from platform-health-agent) ──
CONFLUENCE_URL=https://your-instance.atlassian.net
CONFLUENCE_SPACE_KEY=YOUR_SPACE
CONFLUENCE_PARENT_PAGE_ID=your-parent-page-id
CONFLUENCE_USERNAME=your.email@example.com
CONFLUENCE_API_TOKEN=your-api-token-here

# ── Web Crawler (reused from platform-health-agent) ──
BLOG_URL=https://your-blog-url.com/

# ── LangGraph Agent ──
RECURSION_LIMIT=25
TOOL_TIMEOUT_SECONDS=10
TOOL_MAX_RETRIES=3
MAX_TOKENS_PER_CONVERSATION=50000

# ── HITL Approval (NEW — Phase E) ──
APPROVAL_TIMEOUT_SECONDS=300

# ── Eval Pipeline (NEW — Phase F) ──
EVAL_GOLDEN_TEST_SET=eval/golden_tests.json
EVAL_MIN_FAITHFULNESS=0.70
EVAL_MIN_RELEVANCY=0.65
