{
  "dashboard": {
    "id": null,
    "title": "RAG System Monitoring",
    "tags": ["rag", "kubernetes"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "RAG System Pod CPU Usage",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"rag-system\",container!=\"POD\",container!=\"\"}[5m])) by (pod)",
            "legendFormat": "{{pod}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "RAG System Pod Memory Usage",
        "type": "stat", 
        "targets": [
          {
            "expr": "sum(container_memory_working_set_bytes{namespace=\"rag-system\",container!=\"POD\",container!=\"\"}) by (pod)",
            "legendFormat": "{{pod}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Weaviate Container Metrics",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{namespace=\"rag-system\",pod=~\"weaviate.*\"}[5m])",
            "legendFormat": "CPU - {{container}}"
          },
          {
            "expr": "container_memory_working_set_bytes{namespace=\"rag-system\",pod=~\"weaviate.*\"}/1024/1024",
            "legendFormat": "Memory MB - {{container}}"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "RAG Backend Performance", 
        "type": "graph",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{namespace=\"rag-system\",pod=~\"rag-backend.*\"}[5m])",
            "legendFormat": "CPU Usage"
          },
          {
            "expr": "container_memory_working_set_bytes{namespace=\"rag-system\",pod=~\"rag-backend.*\"}/1024/1024",
            "legendFormat": "Memory MB"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "30s"
  }
}
